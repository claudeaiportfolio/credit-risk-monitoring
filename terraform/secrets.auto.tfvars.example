# Copy to `secrets.auto.tfvars` (git-ignored) and fill in Phase 2.
# Holds every IDENTIFYING or SECRET value — never commit the filled copy.

# --- Shared ACR (identifying; org secret ACR_NAME) ---
acr_name                = "REPLACE_WITH_ACR_NAME"
acr_resource_group_name = "REPLACE_WITH_ACR_RESOURCE_GROUP"

# --- Postgres AAD admin (GUID + name; the group/user that administers the DB) ---
aad_admin_object_id      = "00000000-0000-0000-0000-000000000000"
aad_admin_principal_name = "REPLACE_WITH_ADMIN_GROUP_OR_UPN"
aad_admin_principal_type = "Group" # User | Group | ServicePrincipal

# --- SEC EDGAR descriptive UA (contains a contact email) ---
sec_edgar_user_agent = "credit-risk-monitoring (contact: you@example.com)"

# --- Image tag to deploy (set to the tag/digest pushed to ACR) ---
image_tag = "REPLACE_WITH_PUSHED_TAG"

# --- Secret VALUES (from the shared dev vault localdevenv) ---
#   anthropic_api_key       <- localdevenv/anthropic-portfolio-key
#   companies_house_api_key <- localdevenv/credit-risk-monitoring-ch-api-key
#   braintrust_api_key      <- localdevenv/credit-risk-monitoring-braintrust (optional)
anthropic_api_key       = "REPLACE"
companies_house_api_key = "REPLACE"
braintrust_api_key      = "" # optional; leave empty to disable Braintrust

# AUDIT_DATABASE_URL: assemble AFTER the first apply from the postgres outputs:
#   postgresql://<user>:<password>@<postgres_primary_fqdn>:5432/<database_name>?sslmode=require
# (see README — the module generates the admin password but does not output it;
#  reset it or create a dedicated app role, then set the DSN and re-apply.)
audit_database_url = ""

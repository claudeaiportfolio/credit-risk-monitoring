# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# uv
# (uv.lock IS committed)

# Secrets — never committed; loaded via `uv run --env-file`
.env
.env.*

# Eval outputs (regenerated by `make eval`)
/out/
/traces/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
# tfvars: commit only the non-identifying region file; ignore everything else
# (secrets.auto.tfvars carries GUIDs/ACR name/contact email/secret values).
terraform/*.auto.tfvars
!terraform/uksouth.auto.tfvars
# Laptop provider override (use_cli); the .example template IS committed.
terraform/local_override.tf
